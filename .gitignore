# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Build / dist ──────────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Model cache (large; downloaded at runtime via HuggingFace / EasyOCR) ─────
~/.EasyOCR/
~/.cache/huggingface/

# ── Pipeline outputs (keep the dir stub, ignore generated files) ─────────────
results/*
!results/.gitkeep

# ── Sample images (keep the dir stub, ignore generated PNGs) ─────────────────
samples/*
!samples/.gitkeep

# ── Example assets committed to repo (always track) ──────────────────────────
!examples/

# ── Secrets / config overrides ───────────────────────────────────────────────
.env
*.local

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Video demo script (local reference only) ─────────────────────────────────
VIDEO_DEMO_SCRIPT.txt
