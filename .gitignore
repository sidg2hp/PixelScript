# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Build / dist ──────────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Model cache (large; downloaded at runtime via HuggingFace / EasyOCR) ─────
~/.EasyOCR/
~/.cache/huggingface/

# ── Pipeline outputs ─────────────────────────────────────────────────────────
results/
results/debug/

# ── Sample images (keep the script, not the generated PNGs) ──────────────────
samples/*.png
samples/*.jpg
samples/*.jpeg
samples/*.tiff
samples/*.bmp

# ── Secrets / config overrides ───────────────────────────────────────────────
.env
*.local

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Video demo script (local reference only) ─────────────────────────────────
VIDEO_DEMO_SCRIPT.txt
